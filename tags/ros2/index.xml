&lt;/tr>
&lt;/thead>
&lt;tbody>
&lt;tr>
&lt;td>Original&lt;/td>
&lt;td>80ms&lt;/td>
&lt;td>12Hz&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>+ Multi-threading&lt;/td>
&lt;td>45ms&lt;/td>
&lt;td>22Hz&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>+ GPU Acceleration&lt;/td>
&lt;td>&lt;strong>25ms&lt;/strong>&lt;/td>
&lt;td>&lt;strong>40Hz&lt;/strong>&lt;/td>
&lt;/tr>
&lt;/tbody>
&lt;/table>
